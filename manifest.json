{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "zipper",
  "name": "Zipper",
  "type": "service",
  "version": "1.0.0",
  "description": "Create standard ZIP archives from single or multiple files directly from your context menu",
  "author": "FynnCloud",
  "icon": "heroicons:archive-box-solid",
  "category": "utilities",
  "permissions": [
    "files:read",
    "files:write"
  ],
  "hooks": {
    "file_actions": [
      {
        "id": "zip-files",
        "label": "Compress to ZIP",
        "extensions": [
          "*"
        ],
        "icon": "heroicons:archive-box-solid",
        "target": "/api/zip"
      }
    ]
  },
  "deploy": {
    "image": "ghcr.io/fynncloudproject/app-zipper:latest",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "128MB",
      "cpu": 0.5
    }
  }
}